# Claude / Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Database (для локальной разработки — Docker переопределяет это автоматически)
DATABASE_URL=postgresql+asyncpg://psybot:psybot@localhost:5432/psybot

# Redis (для локальной разработки — Docker переопределяет это автоматически)
REDIS_URL=redis://localhost:6379

# JWT — замените на случайную строку (openssl rand -hex 32)
JWT_SECRET=change-me-to-random-string-in-production

# Payment (optional)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# App
FREE_MESSAGES_PER_DAY=10

# Frontend API URL — укажите публичный IP/домен сервера
# Docker использует это значение при сборке Next.js
NEXT_PUBLIC_API_URL=http://72.56.109.14:8000
